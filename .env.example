# vLLM server on Euler (accessed via SSH tunnel)
# Start tunnel: ./scripts/euler/connect.sh
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=Qwen/Qwen3-14B

# Generation parameters
VLLM_MAX_TOKENS=2048
VLLM_TEMPERATURE=0.7

# Swiss AI Research Platform (https://serving.swissai.svc.cscs.ch)
# Get your API key from the Swiss AI portal and set it below.
CSCS_SERVING_API=sk-your-api-key-here

# Azure OpenAI-compatible judge deployments.
AZURE_OPENAI_BASE_URL=https://your-resource.services.ai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_LUNA_MODEL=gpt-5.6-luna
AZURE_OPENAI_GPT54_MODEL=gpt-5.4
AZURE_OPENAI_GPT41_MODEL=gpt-4.1
AZURE_OPENAI_GPT41_MINI_MODEL=gpt-4.1-mini

# Model roles. The structured role is used by the human-evaluation notebook.
# Qwen 3.5 27B is used for structured PF exercise generation.
SWISSAI_JUDGE_MODEL=Qwen/Qwen3.5-27B
# Optional overrides:
# SWISSAI_GENERATOR_MODEL=Qwen/Qwen3.5-27B
# SWISSAI_EMBED_MODEL=Snowflake/snowflake-arctic-embed-l-v2.0
